# ==============================================================================
# Outside Bubble Scraper Service - Environment Configuration
# ==============================================================================

SCRAPER_HOST=0.0.0.0
SCRAPER_PORT=8000
SCRAPER_ENVIRONMENT=production
SCRAPER_LOG_LEVEL=INFO

SCRAPER_DEFAULT_TIMEOUT_MS=30000
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_RESPONSE_BYTES=15728640

SCRAPER_BROWSER_ENABLED=true
SCRAPER_BROWSER_HEADLESS=true
SCRAPER_BROWSER_POOL_SIZE=4
SCRAPER_BROWSER_TIMEOUT_MS=30000
SCRAPER_BROWSER_VIEWPORT_WIDTH=1280
SCRAPER_BROWSER_VIEWPORT_HEIGHT=800
SCRAPER_BROWSER_STEALTH_ENABLED=true

SCRAPER_SSRF_PROTECTION_ENABLED=true
SCRAPER_ALLOWED_SCHEMES=["http", "https"]

SCRAPER_CACHE_ENABLED=true
SCRAPER_CACHE_TTL_SECONDS=3600
SCRAPER_CACHE_MAX_ENTRIES=1000

SCRAPER_GLOBAL_CONCURRENCY_LIMIT=20
SCRAPER_DOMAIN_CONCURRENCY_LIMIT=2
SCRAPER_DOMAIN_MIN_INTERVAL_SECONDS=0.5
SCRAPER_DOMAIN_COOLDOWN_SECONDS=60.0

SCRAPER_STORAGE_PROVIDER=local
SCRAPER_LOCAL_STORAGE_DIR=./storage

# ==============================================================================
# Webshare Proxy Integration (https://www.webshare.io)
# ==============================================================================
# Option A: Explicit Webshare credentials (Recommended)
SCRAPER_PROXY_PROVIDER=webshare
SCRAPER_WEBSHARE_USERNAME=your_webshare_username
SCRAPER_WEBSHARE_PASSWORD=your_webshare_password
# Datacenter rotating host (default)
SCRAPER_WEBSHARE_HOST=p.webshare.io
SCRAPER_WEBSHARE_PORT=80
# Residential rotating host (use if you have Webshare Residential)
# SCRAPER_WEBSHARE_HOST=rp.webshare.io

# Option B: Single proxy URL (supports auto-credential extraction)
# SCRAPER_PROXY_PROVIDER=webshare
# SCRAPER_PROXY_URL=http://your_username:your_password@p.webshare.io:80
